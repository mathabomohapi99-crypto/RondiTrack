# Copy this file to .env.local and fill in the values. .env.local is git-ignored.
# Neither name starts with NEXT_PUBLIC_, so Next.js never puts them in the browser bundle.

# Where the .NET API runs (only the Next.js server calls it)
API_BASE_URL=http://localhost:5134

# 32 random bytes, base64. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
{
    "Logging":  {
                    "LogLevel":  {
                                     "Default":  "Information",
                                     "Microsoft.AspNetCore":  "Warning",
                                     "Microsoft.EntityFrameworkCore.Database.Command":  "Warning",
                                     "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware":  "None"
                                 }
                },
    "AllowedHosts":  "*",
    "Jwt":  {
                "Issuer":  "RondiTrack",
                "Audience":  "RondiTrack.Api",
                "AccessTokenMinutes":  10,
                "RefreshTokenDays":  7
            },
    "Cors":  {
                 "AllowedOrigins":  [

                                    ]
             },
    "RateLimiting":  {
                         "Login":  {
                                       "PermitLimit":  5,
                                       "WindowSeconds":  60
                                   },
                         "Contribution":  {
                                              "TokenLimit":  30,
                                              "TokensPerPeriod":  5,
                                              "ReplenishSeconds":  60
                                          },
                         "Payout":  {
                                        "TokenLimit":  10,
                                        "TokensPerPeriod":  2,
                                        "ReplenishSeconds":  60
                                    }
                     }
}

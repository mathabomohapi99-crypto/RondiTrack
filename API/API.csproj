<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>bbe90fbd-e83b-464c-9efe-0eba0f1e6237</UserSecretsId> <!-- keeps your dev connection string and the JWT key -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="12.1.1" /> <!-- validators -->
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" /> <!-- AddValidatorsFromAssembly -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" /> <!-- NEW 6.1: JWT validation -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.3" /> <!-- OpenAPI -->
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.7" /> <!-- API docs UI -->

    <!-- Fixes CS1705: same EF version as Infrastructure -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />

    <!-- dotnet ef needs this in the startup project (API) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets> <!-- tooling only, not shipped -->
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Domain\Domain.csproj" /> <!-- API -> Domain (this was missing) -->
    <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" /> <!-- API -> Infrastructure (this was missing) -->
  </ItemGroup>

</Project>